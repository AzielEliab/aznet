{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AzielEliab/aznet/aznet_schema.json",
  "title": "AZNet receipt (AZN-WP-0.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_kind", "prev_hash", "receipt_hash", "timestamp", "payload", "keys", "user_content", "spec", "marker"],
  "properties": {
    "event_kind": { "enum": ["GARDEN", "STAMP", "MEMORIAL", "PAIR", "UNLOCK", "WITNESS", "WITHDRAW"] },
    "prev_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "receipt_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string" },
    "date_stamp": { "type": ["string", "null"] },
    "payload": { "const": "ABSENT" },
    "keys": { "const": "ABSENT" },
    "user_content": { "const": "ABSENT" },
    "spec": { "const": "AZN-WP-0.1" },
    "marker": { "const": "Truth Is No Defense — .AZNet — AZ." },
    "hash_hex": { "type": ["string", "null"] },
    "label": { "type": ["string", "null"] },
    "genesis_hash": { "type": ["string", "null"] },
    "final_hash": { "type": ["string", "null"] },
    "reason": { "type": ["string", "null"] },
    "summary": { "type": ["string", "null"] },
    "pair_status": { "type": ["string", "null"] },
    "unlock_status": { "type": ["string", "null"] },
    "azbrowser": { "type": ["string", "null"] },
    "aznet_node": { "type": ["string", "null"] },
    "fraggate": { "type": ["string", "null"] },
    "staticclock": { "type": ["string", "null"] },
    "zone": { "type": ["string", "null"] },
    "witness_hash": { "type": ["string", "null"] },
    "note": { "type": "string", "maxLength": 80 },
    "actor": { "const": "operator" }
  }
}
